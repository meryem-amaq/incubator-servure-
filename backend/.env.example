PORT=5000
NODE_ENV=development

# Base de données MariaDB / MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=incubateur_cgs
DB_USER=root
DB_PASSWORD=

# Optionnel pour Heroku (JawsDB Maria / MySQL)
# JAWSDB_MARIA_URL=mysql://user:password@host:3306/database

# JWT
JWT_SECRET=cgs_incubateur_secret_key_change_in_production
JWT_EXPIRES_IN=24h

# Upload fichiers
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760

# Frontend URL
FRONTEND_URL=http://localhost:5173

# Rate Limiting (Optionnel)
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_MS=900000

# Synchronisation Cloud Relais (Optionnel - pour connecter à Heroku)
ACTIVER_SYNC_CLOUD=true
CLOUD_URL=https://ids-production-app-6aba82b6af10.herokuapp.com
SYNC_SECRET=ids_secret_sync_key_987654321_secure

